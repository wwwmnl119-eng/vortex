PORT=3000
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/vortex
JWT_SECRET=your_super_secret_jwt_key

# App version control
LATEST_VERSION=1.0.0
MIN_VERSION=1.0.0
FORCE_UPDATE=false
CHANGELOG=Исправления ошибок и улучшения производительности
APK_URL=https://your-site.com/vortex.apk
STORE_URL_ANDROID=https://play.google.com/store/apps/details?id=com.vortex.app
STORE_URL_IOS=https://apps.apple.com/app/vortex/id000000000

# AWS S3 (optional)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=vortex-files
